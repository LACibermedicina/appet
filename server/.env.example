# Copie para .env e preencha. NUNCA faça commit do .env.
PORT=3000
PUBLIC_URL=http://localhost:3000

# ---------- IA (ordem do failsafe: a primeira que responder vence) ----------
AI_ORDER=claude,gemini,openai,pollinations
AI_TIMEOUT_MS=20000

# Claude (chave da API: começa com sk-ant-api…; gere em console.anthropic.com)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# OpenAI (ou endpoint compatível; deixe a base padrão fora do Replit)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Pollinations (endpoint compatível com OpenAI; confira a URL atual na documentação deles)
POLLINATIONS_API_KEY=
POLLINATIONS_BASE_URL=https://text.pollinations.ai/openai
POLLINATIONS_MODEL=openai

# ---------- Vídeo (Agora) ----------
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_TOKEN_TTL=3600

# ---------- Pagamentos ----------
# stripe (Checkout com Link, cartão e Pix quando habilitados na conta) ou mercadopago
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MERCADOPAGO_ACCESS_TOKEN=

# ---------- E-mail (recibos) ----------
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
